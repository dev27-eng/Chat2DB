# Copy this file to `leasecheck.env` before running install.sh
# All values can also be exported in your shell instead of using this file.

# Directory on the Hostinger VPS where the Chat2DB repo will live
INSTALL_DIR="$HOME/leasecheck-cloud"

# Git repository/branch that contains the Colorado Lease Check customisations
GIT_REPO="https://github.com/dev27-eng/Chat2DB.git"
GIT_REF="work"

# Environment exposed to the front-end build
APP_VERSION="1.0.0"
APP_PORT="4173"
PUBLIC_PATH="/"
SITE_NAME="leasecheck-cloud"

# Backend runtime configuration
BACKEND_PORT="8080"
BACKEND_HOST="0.0.0.0"
BACKEND_PROCESS_NAME="leasecheck-backend"
BACKEND_STORAGE_ROOT="$HOME/leasecheck-cloud-data/storage"
BACKEND_DATABASE_PATH="$HOME/leasecheck-cloud-data/data/leases.db"
BACKEND_ALLOWED_ORIGINS="https://leasecheck.cloud"
MAX_UPLOAD_SIZE=$((50 * 1024 * 1024))
FAIRNESS_BASELINE="0.6"

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
BILLING_SUCCESS_URL="https://leasecheck.cloud/success"
BILLING_CANCEL_URL="https://leasecheck.cloud/cancel"

# Qdrant configuration
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="leasecheck_chunks"
QDRANT_VECTOR_DIM="384"
MANAGE_QDRANT_DOCKER="true"

# Optional: path to a file with additional environment variables exported before the build
EXTRA_ENV_FILE=""

# Set to true to skip portions of the build on subsequent deploys
SKIP_DEPS="false"
SKIP_BUILD="false"
